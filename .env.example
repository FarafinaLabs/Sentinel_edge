# ============================================================
# SENTINEL-EDGE — Variables d'environnement (.env)
# Copiez ce fichier en .env et renseignez vos valeurs
# ============================================================

# Source vidéo : 0 = webcam locale, URL HTTP/RTSP, "mock" = mire synthétique
VIDEO_SOURCE=0

# Résolution et FPS cibles
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=25

# Reconnexion réseau (pour IP Webcam / RTSP sur Wi-Fi instable)
RECONNECT_INTERVAL=2.0
MAX_RECONNECT_ATTEMPTS=15

# Détection d'intrusion
CONFIDENCE_THRESHOLD=0.60
PERSISTENCE_FRAMES=2
ALERT_COOLDOWN=10

# Modèle YOLOv8
YOLO_MODEL_PATH=yolov8n.pt

# Telegram Bot (obligatoire pour les alertes)
# Créez votre bot via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
# Récupérez votre Chat ID via @userinfobot ou @getidsbot
TELEGRAM_CHAT_ID=

# Serveur Web Dashboard
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=false

# Stockage local
CAPTURE_DIR=captures
DATABASE_PATH=sentinel.db
